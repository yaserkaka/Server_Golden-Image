# Fallback: if a clone boots without cloud-init generating host keys,
# create them before sshd starts so the machine stays reachable.
[Unit]
Description=Regenerate missing SSH host keys (golden image first boot)
Before=ssh.socket ssh.service
ConditionPathExistsGlob=!/etc/ssh/ssh_host_*_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=multi-user.target
