# Settings handed to every clone's roles (written to /etc/golden-image/role.env).
# Each role uses only the keys it needs; see the header of files/roles/<role>.sh.

# nfs-server / hpc-compute: shared storage on node01, mounted at /shared
NFS_SERVER=192.168.122.11
NFS_EXPORT_DIR=/srv/shared
NFS_MOUNT=/shared

# hpc-compute: network trusted for MPI and Slurm traffic
CLUSTER_CIDR=192.168.122.0/24

# k8s-node: Kubernetes minor version channel
K8S_VERSION=v1.37
